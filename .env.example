# Free local mode is the default. Copy to .env after installing Ollama and models.
PORT=3000
SUPPORT_MODE=free
ROUTER_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_ADVANCED_MODEL=deepseek-r1:8b
USE_OLLAMA=true
# Optional paid integrations; ignored in free mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ROUTE_THRESHOLD=0.72
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
